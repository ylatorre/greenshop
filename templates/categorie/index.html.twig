{% extends 'base.html.twig' %}

{% block title %}Catégories{% endblock %}

{% block body %}

{% include 'composant/affichagePage.html.twig' with {'pageName': 'Catégories'} %}

<div class="flex justify-center flex-wrap gap-4">
    {% for categorie in categories %}
        <div class="categorie-item flex flex-col items-center w-full sm:w-1/2 md:w-1/3 lg:w-1/4 xl:w-1/4 h-auto p-2.5 rounded border border-gray-400 border-opacity-50" data-categorie-id="{{ categorie.id }}" style="flex-shrink: 0; padding: 9px 14px;">
            <img src="/image/produits/{{ categorie.getFirstFicheProduitImage() }}" alt="Image non trouvée" class="w-32 h-32 object-contain p-2">
            <div class="flex flex-col items-center space-y-1 mt-2">
                <span class="text-xs text-center font-medium">{{ categorie.nom }}</span>
            </div>
        </div>
    {% endfor %}
</div>


<script>
    document.querySelectorAll('.categorie-item').forEach(function(item) {
        item.addEventListener('click', function() {
            var categorieId = item.getAttribute('data-categorie-id');
            window.location.href = '{{ path('categorie_show', {'id': 'ID'}) }}'.replace('ID', categorieId);
        });
    });
</script>

</body>
</html>

{% endblock %}
