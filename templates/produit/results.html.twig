{% extends 'base.html.twig' %}

{% block body %}

    {% include './composant/Header.html.twig' %}

    <div class="flex flex-wrap justify-center gap-4">
        {% for ficheProduit in ficheProduits %}
            <a href="{{ path('produit_show', {'id': ficheProduit.id}) }}" class="btn btn-primary">

                <!-- Utilisation des classes Tailwind pour la taille de la carte -->
                <div class="mt-24 w-full bg-white shadow-lg rounded-lg overflow-hidden">
                    <div class="h-48">
                        <!-- Utilisation des classes pour redimensionner l'image de manière responsive -->
                        <img src="/image/produits/{{ ficheProduit.getImageProduit() }}" alt="{{ ficheProduit.titre }}" class="w-full h-full object-cover">
                    </div>
                    <div class="p-4">
                        <h1 class="text-xl font-bold text-gray-800 mb-2">{{ ficheProduit.titre }}</h1>
                        <p class="text-sm text-gray-600 mb-2">{{ ficheProduit.description }}</p>
                        <p class="text-sm text-gray-600 mb-2">{{ ficheProduit.noteProduit }}</p>
                        <div class="flex items-center justify-between">
                            <h1 class="text-sm font-light text-blue-800 border-b border-blue-800 mb-2">{{ ficheProduit.recyclage ? 'Oui' : 'Non' }}</h1>
                            <div class="text-sm text-gray-600">
                                <span class="font-semibold">{{ ficheProduit.prix }}</span>
                            </div>
                        </div>
                    </div>
                </div>

            </a>
        {% else %}
            <p>Aucun produit trouvé dans cette catégorie.</p>
        {% endfor %}
    </div>

{% endblock %}
